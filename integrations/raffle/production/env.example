# Copy outside the website repository into the host's private secret configuration.
# Nothing sends mail or accepts entries with these defaults.
RAFFLE_DB=/data/raffle.sqlite
RAFFLE_ENCRYPTION_KEY_FILE=/run/secrets/raffle_encryption_key
RAFFLE_SITE_ORIGIN=https://alphaff.gg
RAFFLE_MAIL_MODE=disabled
RAFFLE_LIVE_ENABLED=false
# Established site admin address; sender domain reported Verified in Resend by owner; runtime credentials still required.
RAFFLE_FROM=admin@alphaff.gg
RESEND_API_KEY_FILE=/run/secrets/resend_api_key
RAFFLE_TEST_RECIPIENTS=
PORT=8788
